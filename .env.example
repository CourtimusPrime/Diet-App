DEV=true
# Set to false in production (Railway). Controls auth base URL detection.
# DEV=true  → NextAuth auto-detects localhost (default for local dev)
# DEV=false → AUTH_URL or RAILWAY_PUBLIC_DOMAIN used as base URL for OAuth callbacks

DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
# Railway PostgreSQL connection string — find in Railway dashboard > project > variables

OPENROUTER_API_KEY="sk-or-..."
# OpenRouter API key from openrouter.ai/keys
# Required for LLM food parsing (google/gemini-2.5-flash) and confirmation messages
# Add to .env (gitignored) — never commit this value

USDA_API_KEY="DEMO_KEY"
# USDA FoodData Central API key — get a free registered key at: https://fdc.nal.usda.gov/api-guide
# Without a key, DEMO_KEY is used (limit: 30 requests/hr, 3 req/min)
# A registered key raises the limit to 3600 requests/hr
# Optional — DEMO_KEY is used as fallback in app/lib/usda.ts

AUTH_SECRET="your-32-char-secret-here"
# NextAuth JWT signing secret — generate with: npx auth secret
# Required in production; min 32 characters

AUTH_URL="https://your-app.up.railway.app"
# Production base URL for NextAuth OAuth callbacks — only needed when DEV=false
# Railway: auto-detected from RAILWAY_PUBLIC_DOMAIN if this is unset
# Other hosts: set explicitly to your public URL (no trailing slash)

AUTH_TRUST_HOST="true"
# Required on Railway (reverse proxy) so NextAuth trusts the X-Forwarded-Host header
# Set to literal string "true"

GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
# Google OAuth client ID from https://console.cloud.google.com/apis/credentials
# Create an OAuth 2.0 Client ID; set redirect URI to:
# https://your-railway-url.up.railway.app/api/auth/callback/google

GOOGLE_CLIENT_SECRET="your-google-client-secret"
# Google OAuth client secret — same location as GOOGLE_CLIENT_ID
